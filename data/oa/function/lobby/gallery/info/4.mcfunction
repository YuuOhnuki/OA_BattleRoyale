tellraw @s [{"text":"\n━━ ","color":"gold","italic":false},{"text":"キリング：呪いの「き」マスク","color":"#8d59ff","italic":false,"bold":true},{"text":" ━━\n","color":"gold","italic":false},{"text":"","italic":false,"extra":[{"text":"モチーフ：","color":"gray","italic":false},{"text":"F_KiRiSaN_1110","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"","italic":false,"extra":[{"text":"特徴：","color":"gray","italic":false},{"text":"視界を犠牲に、高速移動と確率防御を得るお面。","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"","italic":false,"extra":[{"text":"装備効果：","color":"gray","italic":false},{"text":"拾うと頭へ強制装着。移動速度＋175%・体力の上限が半分、盲目と大音量。最寄りの敵を発光表示。すべてのダメージを20%で無効化。","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"","italic":false,"extra":[{"text":"CT：","color":"gray","italic":false},{"text":"なし／装着の累計45秒で消滅","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"","italic":false,"extra":[{"text":"常時効果：","color":"gray","italic":false},{"text":"移動速度＋175%（標準の2.75倍）。体力の上限が半分（外すと戻る）。盲目と本人だけへの大音量。最寄りの敵を本人だけに発光表示。","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"","italic":false,"extra":[{"text":"防御：","color":"gray","italic":false},{"text":"すべてのダメージを20%で無効化（参加者の攻撃・落下・安地外・災害など。/killと奈落は対象外）。成功時はパリィ音と粒子。","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"","italic":false,"extra":[{"text":"注意：","color":"gray","italic":false},{"text":"通常は取り外せない。TNT鬼の間は装着しない。","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"※固有武器は一人一個まで所持可能\n","color":"gray","italic":false}]
