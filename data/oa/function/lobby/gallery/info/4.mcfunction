tellraw @s [{"text":"\n━━ ","color":"gold","italic":false},{"text":"キリング：呪いの「き」マスク","color":"#8d59ff","italic":false,"bold":true},{"text":" ━━\n","color":"gold","italic":false},{"text":"","italic":false,"extra":[{"text":"モチーフ：","color":"gray","italic":false},{"text":"F_KiRiSaN_1110","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"","italic":false,"extra":[{"text":"特徴：","color":"gray","italic":false},{"text":"視界を犠牲に、高速移動と確率防御を得るお面。","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"","italic":false,"extra":[{"text":"装備効果：","color":"gray","italic":false},{"text":"拾うと頭へ強制装着。移動速度＋175%、盲目と大音量。最寄りの敵を発光表示。すべてのダメージを25%で無効化（攻撃を当ててから3秒間は15%）。","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"","italic":false,"extra":[{"text":"CT：","color":"gray","italic":false},{"text":"なし／装着の累計60秒で消滅","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"","italic":false,"extra":[{"text":"常時効果：","color":"gray","italic":false},{"text":"移動速度＋175%（標準の2.75倍）。盲目と本人だけへの大音量。最寄りの敵を本人だけに発光表示。","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"","italic":false,"extra":[{"text":"防御：","color":"gray","italic":false},{"text":"参加者由来の攻撃を25%で無効化。成功時はパリィ音と粒子。ゆうあも対象、境界ダメージは対象外。","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"","italic":false,"extra":[{"text":"注意：","color":"gray","italic":false},{"text":"通常は取り外せない。TNT鬼の間は装着しない。","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"※固有武器は一人一個まで所持可能\n","color":"gray","italic":false}]
