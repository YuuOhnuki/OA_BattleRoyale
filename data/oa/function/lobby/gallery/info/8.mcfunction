tellraw @s [{"text":"\n━━ ゆー：オーバーワーク ━━\n","color":"gold","italic":false,"bold":true},{"text":"","italic":false,"extra":[{"text":"モチーフ：","color":"gray","italic":false},{"text":"Y_0402","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"","italic":false,"extra":[{"text":"発動：","color":"gray","italic":false},{"text":"操作不要。インベントリ内にあれば致死時に1個消費して自動発動。","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"","italic":false,"extra":[{"text":"CT：","color":"gray","italic":false},{"text":"なし／1回につき1個消費","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"","italic":false,"extra":[{"text":"特徴：","color":"gray","italic":false},{"text":"致死ダメージを肩代わりし、強化と反動を残す消耗品。","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"","italic":false,"extra":[{"text":"発動：","color":"gray","italic":false},{"text":"通常のトーテム効果に加え、吸収II・体力増強IIを5秒。毒I・吐き気Iを10秒。","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"","italic":false,"extra":[{"text":"反動：","color":"gray","italic":false},{"text":"発動10秒後、吐き気III・鈍足IIを15秒。","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"","italic":false,"extra":[{"text":"所持：","color":"gray","italic":false},{"text":"スタック不可。別スロットで複数所持できる。","color":"white","italic":false}]},{"text":"\n","color":"white","italic":false},{"text":"※このアイテムは固有武器と一緒に所持できます（固有武器の所持数に含みません）。\n","color":"gray","italic":false},{"text":"※ダメージは防具・耐性による軽減前。\n","color":"gray","italic":false}]
