# One explosion-time displacement, sampled in 0.2m increments to stop at walls.
# 36 samples preserve the former maximum total of 7.2m; none are scheduled for later ticks.
$execute if score @s oa.kpush matches 1.. at @s rotated $(yaw) 0 positioned ^ ^ ^0.2 run function oa:knockback/probe
